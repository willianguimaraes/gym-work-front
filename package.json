{
  "name": "gym-work-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc -b",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.1",
    "chart.js": "^4.6.2",
    "pinia": "^4.1.0",
    "quasar": "^2.35.6",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "31.0.0",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
